<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="RespondX.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - RespondX</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link runat="server" href="~/Content/Site.css" rel="stylesheet" />
    <link runat="server" href="~/Content/Dashboard.css" rel="stylesheet" />
    <link runat="server" href="~/Content/Admin.css" rel="stylesheet" />
    <link runat="server" href="~/Content/Expert.css" rel="stylesheet" />
    <link runat="server" href="~/Content/Learner.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager runat="server" />
        
        <nav class="navbar">
            <div class="container">
                <a runat="server" href="~/Default.aspx" class="navbar-brand">
                    <i class="fas fa-shield-alt"></i> RespondX
                </a>
                <button type="button" class="navbar-toggler" id="navbarToggler" aria-label="Toggle navigation" aria-expanded="false" aria-controls="navbarLinks">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="navbar-links" id="navbarLinks">
                    <ul>
                        <!-- Always visible public links -->
                        <li><a runat="server" href="~/Default.aspx">Home</a></li>
                        <li><a runat="server" href="~/About.aspx">About</a></li>
                        <li><a runat="server" href="~/Contact.aspx">Contact</a></li>

                        <!-- Guest Links (Not Logged In) -->
                        <asp:PlaceHolder ID="phGuestLinks" runat="server">
                            <li><a runat="server" href="~/Login.aspx">Sign In</a></li>
                            <li><a runat="server" href="~/Signup.aspx">Create Account</a></li>
                        </asp:PlaceHolder>

                        <!-- Learner Links -->
                        <asp:PlaceHolder ID="phLearnerLinks" runat="server" Visible="false">
                            <li><a runat="server" href="~/Learner/LearnerDashboard.aspx">Dashboard</a></li>
                            <li><a runat="server" href="~/Learner/Modules.aspx">Modules</a></li>
                            <li><a runat="server" href="~/Learner/Assignments.aspx">Assignments</a></li>
                            <li><a runat="server" href="~/Learner/Quizzes.aspx">Quizzes</a></li>
                            <li><a runat="server" href="~/Learner/Scenarios.aspx">Scenarios</a></li>
                            <li><a runat="server" href="~/Learner/MyProgress.aspx">Progress</a></li>
                            <li><a runat="server" href="~/Learner/Profile.aspx">Profile</a></li>
                            <li><a runat="server" href="~/Logout.aspx"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                        </asp:PlaceHolder>

                        <!-- Admin Links -->
                        <asp:PlaceHolder ID="phAdminLinks" runat="server" Visible="false">
                            <li><a runat="server" href="~/Admin/AdminDashboard.aspx">Dashboard</a></li>
                            <li><a runat="server" href="~/Admin/ManageUsers.aspx">Users</a></li>
                            <li><a runat="server" href="~/Admin/ManageCategories.aspx">Categories</a></li>
                            <li><a runat="server" href="~/Admin/ManageModules.aspx">Modules</a></li>
                            <li><a runat="server" href="~/Admin/ManageQuizzes.aspx">Quizzes</a></li>
                            <li><a runat="server" href="~/Admin/ManageScenarios.aspx">Scenarios</a></li>
                            <li><a runat="server" href="~/Admin/Reports.aspx">Reports</a></li>
                            <li><a runat="server" href="~/Logout.aspx"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                        </asp:PlaceHolder>

                        <!-- Expert Links -->
                        <asp:PlaceHolder ID="phExpertLinks" runat="server" Visible="false">
                            <li><a runat="server" href="~/Expert/ExpertDashboard.aspx">Dashboard</a></li>
                            <li><a runat="server" href="~/Expert/PendingReviews.aspx">Reviews</a></li>
                            <li><a runat="server" href="~/Expert/ReviewHistory.aspx">History</a></li>
                            <li><a runat="server" href="~/Expert/ManageAssignments.aspx">Assignments</a></li>
                            <li><a runat="server" href="~/Expert/GradeAssignments.aspx">Grades</a></li>
                            <li><a runat="server" href="~/Logout.aspx"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                        </asp:PlaceHolder>
                    </ul>
                </div>
            </div>
        </nav>

        <main>
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <footer class="footer">
            <div class="container">
                <p>&copy; <%: DateTime.Now.Year %> RespondX - Emergency Response Training Platform</p>
            </div>
        </footer>
    </form>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var toggler = document.getElementById('navbarToggler');
            var links = document.getElementById('navbarLinks');
            if (!toggler || !links) return;

            toggler.addEventListener('click', function () {
                var isOpen = links.classList.toggle('active');
                toggler.setAttribute('aria-expanded', isOpen);
                toggler.querySelector('i').className = isOpen ? 'fas fa-times' : 'fas fa-bars';
            });
        });
    </script>
</body>
</html>