<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="RespondX.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - RespondX</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <asp:PlaceHolder runat="server">
        <link href="~/Content/Site.css" rel="stylesheet" />
    </asp:PlaceHolder>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager runat="server" />
        
        <!-- Only show navbar if user is logged in -->
        <asp:Panel ID="pnlNavbar" runat="server" Visible="false">
            <nav class="navbar">
                <div class="container">
                    <a href="~/Learner/LearnerDashboard.aspx" class="navbar-brand">
                        <i class="fas fa-shield-alt"></i> RespondX
                    </a>
                    <asp:Panel ID="pnlNavLinks" runat="server" CssClass="navbar-links">
                        <ul>
                            <li><a href="~/Learner/LearnerDashboard.aspx">Dashboard</a></li>
                            <li><a href="~/Learner/Modules.aspx">Modules</a></li>
                            <li><a href="~/Learner/Quizzes.aspx">Quizzes</a></li>
                            <li><a href="~/Learner/MyProgress.aspx">Progress</a></li>
                            <li><a href="~/Logout.aspx"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                        </ul>
                    </asp:Panel>
                </div>
            </nav>
        </asp:Panel>

        <main>
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <footer class="footer">
            <div class="container">
                <p>&copy; <%: DateTime.Now.Year %> RespondX - Emergency Response Training Platform</p>
            </div>
        </footer>
    </form>
</body>
</html>